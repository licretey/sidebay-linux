{
  "app-id": "org.sidebay.SideBay",
  "runtime": "org.gnome.Platform",
  "runtime-version": "47",
  "sdk": "org.gnome.Sdk",
  "command": "sidebay",
  "finish-args": [
    "--socket=wayland",
    "--socket=x11",
    "--share=network",
    "--device=dri",
    "--filesystem=xdg-config/autostart"
  ],
  "modules": [
    {
      "name": "python-xlib",
      "buildsystem": "simple",
      "build-commands": [
        "pip3 install --prefix=/app --no-deps /run/build/python-xlib/python_xlib-0.33-py2.py3-none-any.whl"
      ],
      "sources": [
        {
          "type": "file",
          "url": "https://files.pythonhosted.org/packages/fc/b8/ff33610932e0ee81ae7f1269c890f697d56ff74b9f5b2ee5d9b7fa2c5355/python_xlib-0.33-py2.py3-none-any.whl",
          "sha256": "c3534038d42e0df2f1392a1b30a15a4ff5fdc2b86cfa94f072bf11b10a164398"
        }
      ]
    },
    {
      "name": "sidebay",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/sidebay /app/bin",
        "cp -r sidebay/* /app/lib/sidebay/",
        "cp -r tests /app/lib/ 2>/dev/null || true",
        "printf '#!/bin/sh\\nexec env PYTHONPATH=\"/app/lib:$(python3 -c \"import site; print(site.getsitepackages()[0])\")\" python3 -m sidebay \"$@\"\\n' > /app/bin/sidebay",
        "chmod +x /app/bin/sidebay",
        "install -Dm644 logos/sidebay-512.png /app/share/icons/hicolor/512x512/apps/org.sidebay.SideBay.png",
        "install -Dm644 org.sidebay.SideBay.desktop /app/share/applications/org.sidebay.SideBay.desktop"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
